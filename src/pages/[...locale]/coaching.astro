---
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import { COACHING_FILM } from '../../data/films';
import { localePath, localeStaticPaths, t, type Locale } from '../../i18n';
import { breadcrumbNode, personNode } from '../../utils/seo';

export const getStaticPaths = localeStaticPaths;

const locale = Astro.props.locale as Locale;
const s = t(locale);
const site = Astro.site;
const poster = await getImage({ src: COACHING_FILM.poster, width: 1600, format: 'webp', quality: 72 });
const crumbs = breadcrumbNode(site, [{ name: s.nav.home, path: localePath(locale) }, { name: s.nav.coaching, path: localePath(locale, '/coaching/') }]);
---
<Base locale={locale} title={s.meta.coachingTitle} description={s.meta.coachingDesc} path="/coaching/" image={COACHING_FILM.poster} jsonLd={[personNode(site, locale), crumbs]}>
  <header class="page-head wrap">
    <p class="eyebrow">{s.coaching.eyebrow}</p>
    <h1 class="h-xl">{s.coaching.title}</h1>
    <p class="lead">{s.coaching.lead}</p>
    <div class="paths">
      <section class="path">
        <h2>{s.coaching.coachTitle}</h2>
        <p>{s.coaching.coachText}</p>
        <a class="link" href="?type=coaching#request">{s.coaching.formTitle}</a>
      </section>
      <section class="path">
        <h2>{s.coaching.consultTitle}</h2>
        <p>{s.coaching.consultText}</p>
        <a class="link" href="?type=consultation#request">{s.coaching.formTitle}</a>
      </section>
    </div>
  </header>
  <div class="wrap">
    <figure class="coaching-film">
      <video controls playsinline preload="none" poster={poster.src} width={COACHING_FILM.width} height={COACHING_FILM.height} style="width:100%;height:auto" aria-label={s.booking.coaching}>
        <source src={COACHING_FILM.src} type="video/mp4" />
        {s.film.noVideo}
      </video>
    </figure>
  </div>
  <section class="section wrap" id="request" aria-labelledby="request-title">
    <div class="contact-grid">
      <div class="contact-grid__intro"><h2 class="h-lg" id="request-title">{s.coaching.formTitle}</h2></div>
      <div class="contact-grid__form"><EnquiryForm locale={locale} initial="coaching" only={['coaching', 'consultation']} /></div>
    </div>
  </section>
</Base>
