---
import { Image, Picture, getImage } from 'astro:assets';
import { ArrowRight, ChevronLeft, ChevronRight, Play, Volume2, VolumeX } from '@lucide/astro';
import Base from '../../layouts/Base.astro';
import Theater from '../../components/Theater.astro';
import Lightbox from '../../components/Lightbox.astro';
import Ticker from '../../components/Ticker.astro';
import CurveCarousel from '../../components/CurveCarousel.astro';
import Clients from '../../components/Clients.astro';
import Reviews from '../../components/Reviews.astro';
import { LOGO_MARK as mark, LOGO_WORDMARK } from '../../config/site';
import { FILMS } from '../../data/films';
import { SITE } from '../../config/site';
import { localePath, localeStaticPaths, t, type Locale } from '../../i18n';
import { personNode, websiteNode } from '../../utils/seo';
import { resolveAlbums } from '../../utils/albums';
import { blur } from '../../utils/placeholder';
import { ABOUT_PHOTO, CURVE_ITEMS, HERO } from '../../data/home';

export const getStaticPaths = localeStaticPaths;

const locale = Astro.props.locale as Locale;
const s = t(locale);
const p = (path: string) => localePath(locale, path);

const heroLandscape = await getImage({ src: HERO.poster, width: Math.min(1920, HERO.poster.width), format: 'webp', quality: 72 });
const heroMobile = await getImage({ src: HERO.posterMobile, width: Math.min(720, HERO.posterMobile.width), format: 'webp', quality: 68 });
// Only the albums marked "Show on the homepage" feed the photo carousels.
const albums = await resolveAlbums({ home: true });
const heroPh = await blur(HERO.poster);
const filmPh = await Promise.all(FILMS.map(async (film) => `${await blur(film.poster, film.focus)}${film.focus ? `;object-position:${film.focus}` : ''}`));
const aboutPh = await blur(ABOUT_PHOTO.image, ABOUT_PHOTO.focus);
// One photo from each album in turn, so neighbouring cards in the curved row differ.
const mixedPhotos = Array.from({ length: Math.max(...albums.map((a) => a.photos.length)) }).flatMap((_, i) => albums.flatMap((a) => (a.photos[i] ? [a.photos[i]] : [])));
// The closing carousel: the cards set in the dashboard (photos or videos, optionally linked), else the album photos.
const curveItems = CURVE_ITEMS
  ? await Promise.all(CURVE_ITEMS.map(async (item) => ({
      ...item,
      ph: item.image ? `${await blur(item.image, item.focus)}${item.focus ? `;object-position:${item.focus}` : ''}` : undefined,
      // A video card shows its photo (if any) as the first frame.
      poster: item.video && item.image ? (await getImage({ src: item.image, width: Math.min(640, item.image.width), format: 'webp', quality: 70 })).src : undefined,
    })))
  : mixedPhotos;

---
<Base locale={locale} title={s.meta.homeTitle} description={s.meta.homeDesc} path="/" hero jsonLd={[websiteNode(Astro.site, locale), personNode(Astro.site, locale)]}>
  <Fragment slot="head">
    <link rel="preload" as="image" href={heroLandscape.src} type="image/webp" media="(min-width: 701px), (orientation: landscape)" fetchpriority="high" />
    <link rel="preload" as="image" href={heroMobile.src} type="image/webp" media="(max-width: 700px) and (orientation: portrait)" fetchpriority="high" />
  </Fragment>

  <section class="hero" id="home" aria-labelledby="hero-title">
    <div class="hero__media">
      <picture>
        <source media="(max-width: 700px) and (orientation: portrait)" srcset={heroMobile.src} type="image/webp" />
        <img src={heroLandscape.src} width="1920" height="1080" alt="" fetchpriority="high" decoding="async" style={heroPh} />
      </picture>
      <!-- No autoplay/preload: home.ts starts the loop once the page has loaded, so it never competes with the first paint.
           The still above is the same frame, so the video fades in over it without a jump. -->
      <!-- One film loops; several play one after another (data-hero-playlist, read by home.ts). -->
      <video data-hero-video muted loop={HERO.playlist.length < 2} playsinline preload="none" aria-hidden="true" tabindex="-1" data-hero-playlist={HERO.playlist.length > 1 ? JSON.stringify(HERO.playlist) : undefined}>
        {HERO.sources.map((v) => <source media={v.media} src={v.src} type="video/mp4" />)}
      </video>
    </div>
    <div class="hero__inner">
      <h1 id="hero-title" class="sr-only">{SITE.name}: {s.hero.sr}</h1>
      <Image class="hero__logo" src={LOGO_WORDMARK} alt="" widths={[360, 560, 760, 1120, 1520]} sizes="(max-width: 700px) 78vw, min(44vw, 760px)" format="webp" quality={90} loading="eager" fetchpriority="high" />
      <div class="hero__rule" aria-hidden="true"></div>
      <p class="hero__role">{s.hero.role}</p>
      <div class="hero__btns">
        <a class="cta-rec" href={p('/contact/')}>
          <span class="cta-rec__dot" aria-hidden="true"></span>
          <span>{s.hero.project}</span>
          <ArrowRight aria-hidden="true" />
        </a>
        <a class="cta-play" href={p('/films/')}>
          <span class="cta-play__ring" aria-hidden="true">
            <svg class="cta-play__reel" viewBox="0 0 56 56"><circle cx="28" cy="28" r="27" /></svg>
            <Play fill="currentColor" />
          </span>
          <span class="cta-play__label">{s.hero.watch}</span>
        </a>
      </div>
    </div>
    <!-- Camera viewfinder over the footage: corner brackets, REC light and the clip's running timecode -->
    <div class="hero__hud" data-hero-hud aria-hidden="true">
      <p class="hero__rec" dir="ltr"><i></i>REC <span data-hero-tc>00:00:00:00</span></p>
    </div>
    <a class="hero__scroll" href="#showcase">{s.hero.scroll}</a>
  </section>

  <Ticker items={[s.hero.role, ...s.services.items.map((i) => i.title)]} />

  <section class="section wrap" id="showcase" aria-labelledby="showcase-title">
    <div class="section-head">
      <div>
        <p class="eyebrow">{s.showcase.eyebrow}</p>
        <h2 class="h-lg" id="showcase-title">{s.showcase.title}</h2>
      </div>
      <div class="filters" role="group" aria-label={s.showcase.filter}>
        <button type="button" data-filter="all" aria-pressed="true">{s.showcase.all}</button>
        <button type="button" data-filter="films" aria-pressed="false">{s.showcase.films}</button>
        <button type="button" data-filter="photo" aria-pressed="false">{s.showcase.photo}</button>
      </div>
    </div>

    <div class="carousel" data-carousel data-autoplay data-panel="films">
      <div class="carousel__head">
        <h3>{s.showcase.films}</h3>
        <a class="more" href={p('/films/')}><span>{s.showcase.moreFilms}</span><ArrowRight class="flip-rtl" aria-hidden="true" /></a>
      </div>
      <div class="carousel__view">
        <button class="carousel__arrow carousel__arrow--prev" type="button" data-prev aria-label={s.showcase.prev}><ChevronLeft class="flip-rtl" aria-hidden="true" /></button>
        <button class="carousel__arrow carousel__arrow--next" type="button" data-next aria-label={s.showcase.next}><ChevronRight class="flip-rtl" aria-hidden="true" /></button>
        <div class="carousel__track" data-track tabindex="0" role="group" aria-label={s.showcase.films}>
          {FILMS.map((film, i) => (
            <article class="tile tile--film" data-src={film.src} data-orient={film.height > film.width ? 'vertical' : undefined}>
              <a class="tile__open" href={p(`/films/${film.slug}/`)} data-film={JSON.stringify({ src: film.src, title: film.title[locale], href: p(`/films/${film.slug}/`), width: film.width, height: film.height })} aria-label={`${s.film.watch}: ${film.title[locale]}`}>
                <Picture src={film.poster} formats={['avif', 'webp']} widths={[480, 800, 1200].filter((w) => w <= film.poster.width)} sizes="min(1040px, 90vw)" alt={film.description[locale]} loading="lazy" decoding="async" quality={68} style={filmPh[i]} />
              </a>
              <span class="tile__live" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="tile__label">{film.title[locale]}</span>
              <button class="tile__sound" type="button" data-sound data-on={s.film.soundOn} data-off={s.film.soundOff} aria-label={s.film.soundOn}>
                <VolumeX data-icon-off aria-hidden="true" /><Volume2 data-icon-on aria-hidden="true" />
              </button>
            </article>
          ))}
        </div>
      </div>
    </div>

    <div class="carousel carousel--tilt" data-carousel data-drag data-panel="photo">
      <div class="carousel__head">
        <h3>{s.showcase.photo}</h3>
        <a class="more" href={p('/photography/')}><span>{s.showcase.morePhotos}</span><ArrowRight class="flip-rtl" aria-hidden="true" /></a>
      </div>
      <div class="carousel__view">
        <button class="carousel__arrow carousel__arrow--prev" type="button" data-prev aria-label={s.showcase.prev}><ChevronLeft class="flip-rtl" aria-hidden="true" /></button>
        <button class="carousel__arrow carousel__arrow--next" type="button" data-next aria-label={s.showcase.next}><ChevronRight class="flip-rtl" aria-hidden="true" /></button>
        <div class="giant" aria-hidden="true">
          <div class="giant__row" data-text={`${SITE.logoAlt} — ${s.showcase.photo} — ${SITE.logoAlt} — ${s.showcase.photo} — `}></div>
          <div class="giant__row giant__row--back" data-text={`${s.hero.role} — ${s.hero.role} — ${s.hero.role} — `}></div>
        </div>
        <div class="carousel__track" data-track tabindex="0" role="group" aria-label={s.showcase.photo}>
          {albums.flatMap((album) => album.photos.map((photo) => (
            <a class="tile tile--photo" href={photo.full.src} data-photo data-album={album.slug} data-album-title={album.title[locale]} data-thumb={photo.thumb.src} aria-label={`${s.photo.open}: ${photo.alt[locale]}`}>
              <Picture src={photo.image} formats={['avif', 'webp']} widths={[480, 800].filter((w) => w <= photo.image.width)} sizes="min(560px, 74vw)" alt={photo.alt[locale]} loading="lazy" decoding="async" quality={70} style={photo.ph} />
              <span class="tile__label">{album.title[locale]}</span>
            </a>
          )))}
        </div>
      </div>
    </div>
  </section>

  <section class="section wrap" id="about" aria-labelledby="about-title">
    <div class="about">
      <div class="about__body">
        <p class="eyebrow">{s.about.eyebrow}</p>
        <h2 class="latin" id="about-title">{SITE.name}</h2>
        <p class="about__text">{s.about.p1}</p>
        <p class="about__text">{s.about.p2}</p>
        <a class="btn" href={p('/contact/')}><span>{s.hero.project}</span><ArrowRight class="flip-rtl" aria-hidden="true" /></a>
      </div>
      <!-- Arch-framed still with a camera REC tag and a turning "role" ring around the MN mark -->
      <figure class="about__media">
        <div class="about__frame">
          <Picture src={ABOUT_PHOTO.image} formats={['avif', 'webp']} widths={[480, 800].filter((w) => w <= ABOUT_PHOTO.image.width)} sizes="(max-width: 760px) 78vw, 440px" alt="" loading="lazy" decoding="async" quality={72} style={`${aboutPh};object-position:${ABOUT_PHOTO.focus}`} />
          <span class="about__rec" dir="ltr" aria-hidden="true"><i></i>REC</span>
        </div>
        <div class="about__badge" aria-hidden="true">
          <svg viewBox="0 0 120 120"><defs><path id="about-ring" d="M60 60m-47 0a47 47 0 1 1 94 0a47 47 0 1 1-94 0" /></defs><text><textPath href="#about-ring" textLength="292" lengthAdjust={locale === 'ar' ? 'spacingAndGlyphs' : 'spacing'}>{`${s.hero.role} · `}</textPath></text></svg>
          <Image src={mark} alt="" width={80} format="webp" quality={90} loading="lazy" />
        </div>
      </figure>
    </div>
  </section>

  <Clients locale={locale} />

  <section class="wrap" id="services" aria-labelledby="services-title" style="padding-block-end:var(--section)">
    <div class="center-head">
      <p class="eyebrow">{s.services.eyebrow}</p>
      <h2 class="h-lg" id="services-title">{s.services.title}</h2>
      <p class="lead">{s.services.sub}</p>
    </div>
    <div class="expertise">
      {s.services.items.map((item, i) => (
        <article class="expertise__item" data-spot>
          <p class="eyebrow">{s.services.production}</p>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
          <a class="link" href={`${p('/contact/')}?service=${encodeURIComponent(item.title)}`}><span>{s.services.learnMore}<span class="sr-only">: {item.title}</span></span></a>
        </article>
      ))}
    </div>
  </section>

  <Reviews locale={locale} />

  <CurveCarousel locale={locale} photos={curveItems} />

  <Theater locale={locale} />
  <Lightbox locale={locale} />
  <script src="../../scripts/home.ts"></script>
</Base>
