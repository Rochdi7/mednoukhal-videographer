---
import { ArrowRight } from '@lucide/astro';
import Field from './Field.astro';
import { t, type Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const s = t(locale);
const f = s.form;
// The dropdown lists the services shown on the homepage (edited in the dashboard), then "Other".
const services = [...s.services.items.map((i) => i.title), f.other];
---
<div data-enquiry-root>
  <form data-enquiry novalidate action="/api/contact.php" method="post" data-errors={JSON.stringify(f.errors)} data-sending={f.sending}>
    <div class="form-grid">
      <Field name="name" label={f.name}><input id="f-name" name="name" type="text" autocomplete="name" autocapitalize="words" enterkeyhint="next" required minlength="2" maxlength="100" /></Field>
      <Field name="email" label={f.email}><input id="f-email" name="email" type="email" autocomplete="email" inputmode="email" enterkeyhint="next" required maxlength="160" dir="ltr" /></Field>
      <Field name="phone" label={f.phone}><input id="f-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" enterkeyhint="next" required pattern="[+0-9 ().\-]{6,25}" dir="ltr" /></Field>
      <Field name="service" label={f.need}>
        <select id="f-service" name="service" required><option value="">{f.choose}</option>{services.map((v) => <option value={v}>{v}</option>)}</select>
      </Field>
      <Field name="message" label={f.message} wide><textarea id="f-message" name="message" required minlength="2" maxlength="4000" placeholder={f.descriptionHint}></textarea></Field>
    </div>
    <div class="hp" aria-hidden="true"><label>{f.honeypot}<input type="text" name="company" tabindex="-1" autocomplete="off" /></label></div>
    <input type="hidden" name="started" value="" />
    <input type="hidden" name="locale" value={locale} />
    <div class="form-foot">
      <button class="btn" type="submit"><span data-submit-label>{f.submit}</span><ArrowRight class="flip-rtl" aria-hidden="true" /></button>
      <p class="form-status" data-status role="alert"></p>
    </div>
    <noscript><p class="form-noscript">{f.noscript}</p></noscript>
  </form>
  <div class="form-success" data-success tabindex="-1" hidden>
    <h2>{f.successTitle}</h2>
    <p>{f.successText}</p>
    <button class="link" type="button" data-again>{f.another}</button>
  </div>
</div>
<script src="../scripts/form.ts"></script>
