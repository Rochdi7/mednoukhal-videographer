---
// Full-screen loader: a counter runs to 100%, then the black screen breaks into tiles that clear away.
// Behaviour lives in scripts/preloader.ts. Hidden without JavaScript and for reduced motion.
---
<div class="preloader" data-preloader aria-hidden="true">
  <p class="preloader__count" dir="ltr"><span data-preloader-num>0</span><span class="preloader__pct">%</span></p>
</div>
<script src="../scripts/preloader.ts"></script>
