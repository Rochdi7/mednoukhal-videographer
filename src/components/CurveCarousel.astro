---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { ArrowUpRight } from '@lucide/astro';
import { localePath, t, type Locale } from '../i18n';

// ph: blurred stand-in, set on the card rather than the img so the photo fades in over it once decoded (curve.ts).
// A card is a photo or a video (muted, playing only while in view), and can link somewhere (set in the dashboard).
interface Card { image?: ImageMetadata; ph?: string; video?: string; poster?: string; href?: string }
interface Props { locale: Locale; photos: Card[] }
const { locale, photos } = Astro.props;
const s = t(locale);
---
<section class="curve" aria-labelledby="curve-title" data-curve>
  <div class="curve__intro">
    <h2 id="curve-title">{s.curve.title}</h2>
    <p class="curve__lead">{s.curve.lead}</p>
    <span class="curve__note curve__note--work" aria-hidden="true">{s.curve.noteWork}</span>
    <svg class="curve__arrow flip-rtl" viewBox="0 0 210 126" fill="none" aria-hidden="true">
      <path d="M4 10C58-2 150-6 190 38c18 22 4 58-14 84" />
      <path d="M177 120c10 1 20 1 30 1M176 122c0-10 2-20 6-30" />
    </svg>
  </div>

  <!-- Decorative moving row (its photos appear in the portfolio above), so it is hidden from screen readers;
       linked cards stay reachable by mouse and touch only. -->
  <div class="curve__stage" data-curve-stage aria-hidden="true">
    {photos.map((card) => {
      const Tag = card.href ? 'a' : 'div';
      const external = card.href && /^https?:/.test(card.href);
      return (
        <Tag class:list={['curve__card', { 'curve__card--link': card.href }]} data-curve-card style={card.ph} href={card.href} tabindex={card.href ? -1 : undefined} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined} draggable="false">
          {card.video ? (
            <video src={card.video} muted loop playsinline preload="none" data-curve-video poster={card.poster} />
          ) : (
            card.image && <Picture src={card.image} formats={['avif', 'webp']} widths={[320, 640].filter((w) => w <= card.image!.width)} sizes="(max-width: 640px) 42vw, (max-width: 1024px) 23vw, 20vw" alt="" loading="lazy" decoding="async" draggable="false" quality={70} />
          )}
          {card.href && <span class="curve__go" aria-hidden="true"><ArrowUpRight /></span>}
        </Tag>
      );
    })}
  </div>

  <div class="curve__foot">
    <div class="curve__cta">
      <span class="curve__note curve__note--cta" aria-hidden="true">{s.curve.noteCta}</span>
      <svg class="curve__squiggle flip-rtl" viewBox="0 0 128 60" fill="none" aria-hidden="true">
        <path d="M2 12C30 0 62 4 72 30c8 22-12 28-16 10-6-26 30-42 48-28 10 8 16 18 20 26" />
      </svg>
      <a class="curve__btn" href={localePath(locale, '/contact/')}>
        <span>{s.curve.cta}</span><ArrowUpRight class="flip-rtl" aria-hidden="true" />
      </a>
    </div>
  </div>
</section>
<script src="../scripts/curve.ts"></script>
