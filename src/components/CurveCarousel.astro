---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { ArrowUpRight } from '@lucide/astro';
import { localePath, t, type Locale } from '../i18n';

interface Props { locale: Locale; photos: { image: ImageMetadata }[] }
const { locale, photos } = Astro.props;
const s = t(locale);
---
<section class="curve" aria-labelledby="curve-title" data-curve>
  <div class="curve__intro">
    <h2 id="curve-title">{s.curve.title}</h2>
    <p class="curve__lead">{s.curve.lead}</p>
    <span class="curve__note curve__note--work" aria-hidden="true">{s.curve.noteWork}</span>
    <svg class="curve__arrow flip-rtl" viewBox="0 0 210 126" fill="none" aria-hidden="true">
      <path d="M4 10C58-2 150-6 190 38c18 22 4 58-14 84" />
      <path d="M177 120c10 1 20 1 30 1M176 122c0-10 2-20 6-30" />
    </svg>
  </div>

  <!-- The same photographs appear in the portfolio above, so this moving row is hidden from screen readers. -->
  <div class="curve__stage" data-curve-stage aria-hidden="true">
    {photos.map((photo) => (
      <div class="curve__card" data-curve-card>
        <Picture src={photo.image} formats={['avif', 'webp']} widths={[320, 640].filter((w) => w <= photo.image.width)} sizes="(max-width: 900px) 200px, 20vw" alt="" loading="lazy" decoding="async" quality={70} />
      </div>
    ))}
  </div>

  <div class="curve__foot">
    <div class="curve__cta">
      <span class="curve__note curve__note--cta" aria-hidden="true">{s.curve.noteCta}</span>
      <svg class="curve__squiggle flip-rtl" viewBox="0 0 128 60" fill="none" aria-hidden="true">
        <path d="M2 12C30 0 62 4 72 30c8 22-12 28-16 10-6-26 30-42 48-28 10 8 16 18 20 26" />
      </svg>
      <a class="curve__btn" href={`${localePath(locale, '/contact/')}?type=project`}>
        <span>{s.curve.cta}</span><ArrowUpRight class="flip-rtl" aria-hidden="true" />
      </a>
    </div>
  </div>
</section>
<script src="../scripts/curve.ts"></script>
