# Copy to .env (never commit .env). Only needed to build locally from the live dashboard content. See docs/dashboard.md.
# The live site, and the deploy_token from public_html/api/config.php on the server.
CMS_URL=https://mednoukhal.com
CMS_TOKEN=
# Or build from a local content file instead (npm run admin:local sets this itself).
# CMS_FILE=mn-data/content.json
# The live address, used for canonical links and the sitemap.
SITE_URL=https://mednoukhal.com
